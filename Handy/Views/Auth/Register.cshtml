@model RegistrationModel
@{
    ViewData["Title"] = "Регистрация";
}

<form asp-action="RegisterProceed" method="post">
    <input type="text" asp-for="email" placeholder="Почта"/>
    <input type="text" asp-for="displayName" placeholder="Отображаемое имя"/>
    <input type="text" asp-for="password" placeholder="Пароль"/>
    <input type="text" placeholder="Подтверждение пароля">
    <input type="text" asp-for="phone" placeholder="Номер телефона"/>
    <button type="submit">Войти</button>
</form>