@using Microsoft.AspNetCore.Http.Features
@model BillutinboardModel
@{
    ViewData["Title"] = "Вход";
}

<link rel="stylesheet" href="~/css/home.css" />
<link rel="stylesheet" href="~/css/ad.css" />
<link rel="stylesheet" href="~/css/auth.css" />

<div class="home-page">
    <div class="home-card ad-card">
        <h1 class="auth-title">СОЗДАНИЕ ОБЪЯВЛЕНИЯ</h1>
        <form action="Submit" method="post" class="ad-form" enctype="multipart/form-data">
            <div class="form-group">
                <label asp-for="ADTitle" class="form-label">Название объявления</label>
                <input asp-for="ADTitle" class="form-input" placeholder="Введите название" />
            </div>

            <div class="form-group">
                <label asp-for="ADDescription" class="form-label">Описание объявления</label>
                <textarea asp-for="ADDescription" class="form-textarea" rows="4" placeholder="Опишите ваше предложение..."></textarea>
            </div>
            <div class="form-group">
                <label class="form-label">Изображения</label>
                <div class="file-input-wrapper">
                    <input type="file" name="files" class="file-input" multiple accept=".jpg, .jpeg, .png, .gif, .bmp, .tiff, .webp"/>
                </div>
            <div class="file-info" id="fileInfo"></div>
                <small class="form-hint"> Поддерживаемые форматы: JPG, PNG, GIF, BMP, TIFF, WEBP</small>
            </div>
            @* <div class="form-group"> *@
            @*     <label asp-for="ADPreviewImageUrl" class="form-label">Ссылка на картинку</label> *@
            @*     <input asp-for="ADPreviewImageUrl" class="form-input" placeholder="https://example.com/photo.jpg" /> *@
            @* </div> *@

            <div class="form-row">
                <div class="form-group half">
                    <label asp-for="ADPrice" class="form-label">Цена</label>
                    <input asp-for="ADPrice" type="number" class="form-input" placeholder="0" min="0" step="1" />
                </div>

                <div class="form-group half">
                    <label asp-for="ADType" class="form-label">Выберите тип объявления</label>
                    <select asp-for="ADType" class="form-select">
                        <option value="1">Выберите тип объявления</option>
                        <option value="2">Услуга</option>
                        <option value="3">Товар</option>
                    </select>
                </div>
            </div>

            @* <div class="form-group"> *@
            @*     <label asp-for="AuthorPhoneNumber" class="form-label">Ваш номер телефона</label> *@
            @*     <input asp-for="AuthorPhoneNumber" class="form-input" placeholder="+7 (999) 123-45-67" /> *@
            @* </div> *@

            <div class="form-group">
                <label asp-for="Address" class="form-label">Адрес</label>
                <input asp-for="Address" class="form-input" placeholder="Город, улица, дом" />
            </div>

            <button type="submit" class="btn-submit btn-create">Создать</button>
        </form>
    </div>
</div>