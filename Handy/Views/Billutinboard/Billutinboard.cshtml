@using Microsoft.AspNetCore.Http.Features
@model List<BillutinboardModel>
@{
    ViewData["Title"] = "Вход";
}

<div>объявления</div>
<a asp-controller="Billutinboard" asp-action="Create">Создать объявление</a>

@foreach(var Item in Model)
{
    <p>@Item.ID @Item.ADTitle @Item.ADDescription @Item.ADPreviewImageUrl @Item.ADPrice @Item.ADType @Item.Address @Item.PublicationDate @Item.UserID</p>
}